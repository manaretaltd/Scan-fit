# Use the EXISTING Elevate CRM Supabase project, not a new disconnected database.
# Configure values securely in hosting settings. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-EXISTING-CRM-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-securely-with-existing-server-only-service-role-key
# This is the separate client app origin; do not change the CRM service APP_URL.
APP_URL=https://YOUR-SEPARATE-SCAN-FIT-APP.example
# Client submissions never automatically update order measurements.
SCAN_FIT_ALLOW_TEST_ORDER_WRITES=0
